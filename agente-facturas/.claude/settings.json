{
  "permissions": {
    "allow": [
      "Read(./scripts/**)",
      "Read(./datos/salida/**)",
      "Read(./datos/entrada/**)",
      "Read(./datos/banco/**)",
      "Read(./datos/maestros/**)",
      "Read(./config.yaml)",
      "Bash(python3 scripts/procesar.py:*)",
      "Bash(python3 scripts/conciliar.py --mes:*)",
      "Bash(python3 scripts/reporte.py:*)",
      "Bash(python3 scripts/ingestar_m365.py:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(python3 scripts/conciliar.py --mes * --confirmar:*)",
      "Edit(./datos/maestros/**)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./datos/.secretos/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(./datos/entrada/**)",
      "Edit(./datos/banco/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm:*)",
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/auditoria.py\"" }
        ]
      }
    ]
  }
}
